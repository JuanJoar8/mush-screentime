<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Feed Quarantine</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<!-- Without this key the bundle takes a default identifier that is not prefixed with
	     the app's, and the build fails at the embed step with a message that names
	     neither the key nor the target. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<!-- A content blocker, not a Safari Web Extension. The extension point decides
		     everything: this one hands WebKit a rule list and is then done, so it runs no
		     code while the person browses and can see nothing they do. A web extension
		     would run JavaScript on every page and need host permissions we have no
		     reason to ask for. -->
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.Safari.content-blocker</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ContentBlockerRequestHandler</string>
	</dict>
</dict>
</plist>
